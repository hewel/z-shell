{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@hewel/zgui/oxlint/recommended.json"],
  "plugins": ["eslint", "typescript", "oxc"],
  "jsPlugins": ["./tools/oxlint-design-plugin.mjs"],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "target/**",
    ".claude/**",
    ".agents/**",
    "apps/shell/src/plugins/composed.ts"
  ],
  "rules": {
    "zshell/no-lint-suppression": "error"
  },
  "overrides": [
    {
      "files": [
        "apps/shell/src/**/*.tsx",
        "apps/shell/src/**/*.ts",
        "plugins/*/src/**/*.tsx",
        "packages/sdk/src/zgui-*.tsx"
      ],
      "rules": {
        "zshell/no-raw-colors": "error",
        "zshell/valid-color-roles": "error",
        "zshell/calm-active-surface": "error",
        "zshell/no-system-ui-font": "error",
        "zshell/valid-radius-scale": "error",
        "zshell/no-mobile-copy": "error",
        "zshell/no-outline-none": "error",
        "zshell/expressive-budget": "error",
        "zshell/no-hand-authored-expressive-paths": "error",
        "zshell/material-icon-grid": "error",
        "zshell/single-owner-ia": "error",
        "zshell/split-action-divider": "error",
        "zshell/tabular-readout": "error",
        "zshell/bluetooth-safe-action": "error",
        "zshell/composite-input-focus": "error",
        "zshell/no-hover-hit-target-shift": "error",
        "zshell/no-flush-surface-shadow": "error",
        "zshell/no-core-plugin-id-branching": "error",
        "zshell/m3-motion-tokens": "error",
        "zshell/no-direct-raf-loop": "error",
        "zshell/solid-show-keyed-callback": "error",
        "zshell/min-hit-target-size": "error",
        "zshell/no-pill-action-button": "error",
        "zshell/semantic-elevation-tokens": "error",
        "zshell/no-unblurred-translucent-surface": "error",
        "zshell/no-duplicate-primitives": "error",
        "zshell/concentric-geometry": "error",
        "zshell/scoped-dismiss-instant": "error",
        "zshell/interactive-hover-radius": "error",
        "zshell/centered-text-badge": "error",
        "zshell/no-partial-card-hover": "error",
        "zshell/consistent-active-hover-shape": "error",
        "zshell/no-child-control-overflow": "error",
        "zgui/prefer-stylesheet": "error"
      }
    },
    {
      "files": ["plugins/*/src/**/*.tsx"],
      "rules": {
        "zshell/no-core-plugin-id-branching": "off"
      }
    },
    {
      "files": ["apps/shell/src/theme.ts"],
      "rules": {
        "zshell/no-raw-colors": "off"
      }
    },
    {
      "files": ["packages/composer/src/manifest.ts"],
      "rules": {
        "no-control-regex": "off"
      }
    },
    {
      "files": ["**/tests/**", "tools/**"],
      "rules": {
        "zshell/no-lint-suppression": "off",
        "zgui/no-lint-suppression": "off"
      }
    },
    {
      "files": [
        "packages/composer/**",
        "packages/plugin-api/**",
        "packages/sdk/src/client.ts",
        "packages/sdk/src/motion.ts",
        "packages/sdk/src/zgui-transport.ts",
        "plugins/*/src/*.ts",
        "tools/**",
        "scripts/**",
        "**/tests/**"
      ],
      "rules": {
        "no-restricted-globals": "off"
      }
    },
    {
      "files": ["packages/sdk/src/motion.ts"],
      "rules": {
        "zgui/no-direct-bridge": "off"
      }
    },
    {
      "files": ["packages/sdk/src/zgui-motion.ts"],
      "rules": {
        "solid/reactivity": "off"
      }
    },
    {
      "files": ["packages/sdk/tests/zgui.test.ts"],
      "rules": {
        "zgui/no-solid-web-imports": "off"
      }
    }
  ]
}
