{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@hewel/zgui-build": ["./src/zgui-build.d.ts"]
    },
    "types": ["bun", "node"],
    "typeRoots": [
      "./node_modules/@types",
      "./node_modules",
      "../../node_modules/@types",
      "../../node_modules"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
