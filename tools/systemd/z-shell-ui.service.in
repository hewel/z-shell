[Unit]
Description=z-shell Desktop Shell UI Host
Documentation=https://github.com/hewel/z-shell
PartOf=graphical-session.target
Requires=z-shelld.service
After=graphical-session.target z-shelld.service
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=XDG_RUNTIME_DIR

[Service]
Type=simple
ExecStart="@BINDIR@/z-shell-session" --ui-only
Restart=on-failure
RestartSec=1
RestartPreventExitStatus=75

[Install]
WantedBy=graphical-session.target
