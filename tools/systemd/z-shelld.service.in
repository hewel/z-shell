[Unit]
Description=z-shell Desktop Shell Daemon
Documentation=https://github.com/hewel/z-shell
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=XDG_RUNTIME_DIR

[Service]
Type=simple
ExecStart="@BINDIR@/z-shelld"
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
